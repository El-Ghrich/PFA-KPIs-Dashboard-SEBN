# Environment Toggle: "local" (Dockerized Postgres) or "production" (Neon Cloud DB)
ENVIRONMENT=local

# Local Dockerized Postgres Settings
POSTGRES_SERVER=localhost
POSTGRES_USER=kpi_user
POSTGRES_PASSWORD=SecurePassword123
POSTGRES_DB=kpi_dashboard
POSTGRES_PORT=5433

# Production Neon DB Connection String
NEON_DATABASE_URL='postgresql://user:password@host/dbname?sslmode=require'

# Security & Tokens
ALGORITHM=HS256
JWT_SECRET_KEY="your-jwt-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# General App Config
API_V1_STR=/api/v1
VERSION="1.0.0"
PROJECT_NAME="HCM-S CIM3 KPI Dashboard"

# Optional Storage Settings
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
